@{
    Layout = "_LayoutAuth";
    ViewData["FlashAuth"] = true;
    ViewData["Title"] = "Iniciar sesión";
}
<p>Tu plataforma para aprender programación.</p>

<h2>Iniciar sesión</h2>
<p>Entrá como estudiante, profesor o administrador.</p>

<partial name="_Flash" />

<form asp-action="Login" method="post">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]">
    <input type="text" name="usuario" placeholder="Usuario" required autocomplete="username" autofocus>
    <input type="password" name="password" placeholder="Contraseña" required autocomplete="current-password">
    <button type="submit">Entrar</button>
</form>

<p style="margin-top:16px;">
    ¿No tenés cuenta? <a asp-action="Registro">Registrate como estudiante</a>
</p>
