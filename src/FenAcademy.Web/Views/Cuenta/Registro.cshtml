@{
    Layout = "_LayoutAuth";
    ViewData["FlashAuth"] = true;
    ViewData["Title"] = "Registro";
}
<p>Creá tu cuenta de estudiante.</p>

<h2>Registro</h2>
<p>Los profesores son habilitados por un administrador.</p>

<partial name="_Flash" />

<form asp-action="Registro" method="post">
    <input type="text" name="nombre" placeholder="Nombre completo" required value="@ViewData["Nombre"]">
    <input type="text" name="usuario" placeholder="Elegí tu usuario" required autocomplete="username" value="@ViewData["Usuario"]">
    <input type="password" name="password" placeholder="Contraseña (mínimo 6 caracteres)" required minlength="6" autocomplete="new-password">
    <input type="password" name="confirmar" placeholder="Confirmar contraseña" required autocomplete="new-password">
    <button type="submit">Registrarme</button>
</form>

<p style="margin-top:16px;">
    ¿Ya tenés cuenta? <a asp-action="Login">Iniciá sesión</a>
</p>
