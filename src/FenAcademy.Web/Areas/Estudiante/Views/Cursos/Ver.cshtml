@model CursoEstudianteVM
@{
    ViewData["Title"] = Model.Curso.Nombre;
    var porClase = Model.Notas.Where(n => n.Actividad.ClaseId is not null).ToLookup(n => n.Actividad.ClaseId);
}
<section class="course-banner">
    <div class="course-banner-overlay">
        <h1>@Model.Curso.Nombre</h1>
        <p>@Model.Curso.Codigo · @Model.Curso.Lenguaje · Nivel @Model.Curso.Nivel · Profesor: @(Model.Curso.Profesor?.Nombre ?? "por asignar") · @Ui.ChipMatricula(Model.Matricula.Estado)</p>
    </div>
</section>

<partial name="_Tabs" model='new List<(string, string, string)> { ("clases", "Clases", "class"), ("evaluacion", "Evaluación", "eval"), ("recursos", "Recursos", "folder") }' />

@* ---------------------------------------------------------------- CLASES *@
<div id="clases" class="tab-content active-tab">
    <div class="course-panel">
        <div class="panel-title">Clases</div>
        <div class="course-list">
            @foreach (var clase in Model.Clases)
            {
                <div class="course-item">
                    <h3>Clase @clase.Orden: @clase.Titulo</h3>
                    <p>@clase.Descripcion</p>
                    @foreach (var n in porClase[clase.Id])
                    {
                        <a class="clase-tarea" asp-controller="Actividades" asp-action="Ver" asp-route-id="@n.Actividad.Id">
                            @(n.Actividad.EsExamen ? "🧪" : "📝") @n.Actividad.Titulo · @Ui.Pct(n.Actividad.Valor) @Ui.ChipEntrega(n.Entrega?.Estado)
                        </a>
                    }
                </div>
            }
            @if (Model.Clases.Count == 0)
            {
                <div class="course-item">
                    <h3>Sin clases</h3>
                    <p>Tu profesor todavía no publicó clases.</p>
                </div>
            }
        </div>
    </div>
</div>

@* ------------------------------------------------------------ EVALUACIÓN *@
<div id="evaluacion" class="tab-content">
    <div class="course-panel">
        <div class="panel-title">Evaluación</div>
        <div class="evaluation-wrapper compact-evaluation-wrapper">
            <table class="evaluation-table compact-evaluation-table">
                <thead>
                    <tr><th>Actividad</th><th>Tipo</th><th>Fecha límite</th><th>Estado</th><th>Valor</th><th>Nota</th><th>Aporte</th></tr>
                </thead>
                <tbody>
                    @foreach (var n in Model.Notas)
                    {
                        <tr class="click-row" data-href="@Url.Action("Ver", "Actividades", new { id = n.Actividad.Id })">
                            <td>
                                <strong>@n.Actividad.Titulo</strong>
                                <p>@(n.Actividad.Clase is null ? "Actividad general" : $"Clase {n.Actividad.Clase.Orden}: {n.Actividad.Clase.Titulo}")</p>
                            </td>
                            <td>@Ui.ChipTipo(n.Actividad.Tipo)</td>
                            <td>@Ui.Fecha(n.Actividad.FechaLimite)</td>
                            <td>@Ui.ChipEntrega(n.Entrega?.Estado)</td>
                            <td>@Ui.Pct(n.Actividad.Valor)</td>
                            <td><span class="grade-chip">@(n.Entrega?.Nota is null ? "—" : Ui.Num(n.Entrega.Nota) + "/100")</span></td>
                            <td>@Ui.Num(n.Aporte)</td>
                        </tr>
                    }
                    @if (Model.Notas.Count == 0)
                    {
                        <tr><td colspan="7">No hay actividades registradas.</td></tr>
                    }
                    <tr class="evaluation-total-row">
                        <td colspan="4">Nota acumulada (evaluado @Ui.Pct(Model.Resumen.PorcentajeEvaluado) de @Ui.Pct(Model.Resumen.TotalValor))</td>
                        <td>@Ui.Pct(Model.Resumen.TotalValor)</td>
                        <td colspan="2"><strong>@Ui.Num(Model.Resumen.NotaAcumulada)/100</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@* -------------------------------------------------------------- RECURSOS *@
<div id="recursos" class="tab-content">
    <section class="resource-hero">
        <div class="resource-hero-icon">↓</div>
        <div>
            <h1>Recursos</h1>
            <p>Material de apoyo compartido por tu profesor.</p>
        </div>
    </section>

    <div class="resource-list resource-list-full">
        @foreach (var r in Model.Recursos)
        {
            <div class="resource-card">
                <div>
                    <h3>@r.Titulo</h3>
                    <p>Subido por @r.Usuario.Nombre · @Ui.Fecha(r.FechaSubida)</p>
                    @if (r.NombreOriginal is not null) { <span>@r.NombreOriginal</span> }
                    @if (r.Enlace is not null) { <p><a class="link-repo" href="@r.Enlace" target="_blank" rel="noopener noreferrer">@r.Enlace</a></p> }
                </div>
                @if (r.Archivo is not null)
                {
                    <a asp-area="" asp-controller="Archivos" asp-action="Recurso" asp-route-id="@r.Id">Descargar</a>
                }
            </div>
        }
        @if (Model.Recursos.Count == 0)
        {
            <div class="course-item">
                <h3>Sin recursos aún</h3>
                <p>Aquí aparecerá el material que comparta tu profesor.</p>
            </div>
        }
    </div>
</div>
