@model EstudianteInicioVM
@{
    ViewData["Title"] = "Inicio";
    var hoy = DateOnly.FromDateTime(DateTime.Today);
}
<section class="welcome-banner">
    <div class="warning-icon">!</div>
    <p>Hola <strong>@User.Nombre()</strong>. Bienvenido a Fen Academy. Aquí verás tus cursos y tus actividades pendientes.</p>
</section>

<section class="main-panels">
    <div class="student-panel">
        <div class="panel-title">Panel del estudiante</div>

        <div class="hero-dashboard-card">
            <div class="hero-dashboard-text">
                <h1>Tu aula virtual está lista</h1>
                <p>Revisá clases, entregá tus trabajos (archivo o repositorio de GitHub), rendí exámenes y seguí tus notas.</p>
                <a asp-action="Matricula" class="hero-dashboard-badge">Ver matrícula</a>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card"><span>Cursos</span><strong>@Model.Matriculas.Count</strong></div>
            <div class="stat-card"><span>Actividades pendientes</span><strong>@Model.Pendientes.Count</strong></div>
        </div>

        <div class="quick-grid">
            @foreach (var m in Model.Matriculas)
            {
                <a asp-controller="Cursos" asp-action="Ver" asp-route-id="@m.CursoId" class="course-link-card">
                    <div class="quick-card course-card">
                        <h3>@m.Curso.Codigo · @m.Curso.Nombre</h3>
                        <p><strong>Lenguaje:</strong> @m.Curso.Lenguaje · <strong>Nivel:</strong> @m.Curso.Nivel</p>
                        <p>@m.Curso.Descripcion</p>
                        @Ui.ChipMatricula(m.Estado)
                    </div>
                </a>
            }
            @if (Model.Matriculas.Count == 0)
            {
                <div class="quick-card">
                    <h3>Sin cursos todavía</h3>
                    <p>Entrá a <a class="activity-link" asp-action="Matricula">Matrícula</a> y elegí tu primer curso.</p>
                </div>
            }
        </div>
    </div>

    <aside class="bulletin-panel">
        <div class="panel-title">Por entregar</div>
        <div class="pending-list">
            @foreach (var a in Model.Pendientes.Take(6))
            {
                <a class="pending-item" asp-controller="Actividades" asp-action="Ver" asp-route-id="@a.Id">
                    <strong>@a.Titulo @Ui.ChipTipo(a.Tipo)</strong>
                    <span>@a.Curso.Nombre</span>
                    <small class="@(a.FechaLimite < hoy ? "texto-alerta" : "")">
                        @(a.FechaLimite is null ? "Sin fecha límite" : "Vence " + Ui.Fecha(a.FechaLimite))
                    </small>
                </a>
            }
            @if (Model.Pendientes.Count == 0)
            {
                <p class="muted">¡Estás al día! No tenés actividades pendientes.</p>
            }
        </div>

        <div class="panel-title">Noticias tech</div>
        <div class="tech-news-card">
            <span>@Model.Noticia.Categoria</span>
            <h3>@Model.Noticia.Titulo</h3>
            <p>@Model.Noticia.Texto</p>
        </div>
    </aside>
</section>
