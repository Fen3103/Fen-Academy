@model RendirVM
@{
    ViewData["Title"] = Model.Examen.Titulo;
    ViewData["Seccion"] = "Examen en curso";
}

<section class="course-panel">
    <div class="panel-title">@Model.Examen.Titulo</div>
    <p class="muted panel-help">Respondé todas las preguntas y presioná <strong>Enviar examen</strong>. Solo tenés un intento.
        Las respuestas cortas no distinguen mayúsculas ni tildes.</p>

    @if (Model.Vence is DateTime vence)
    {
        @* El reloj usa los segundos restantes calculados en el servidor (no la hora de la PC del estudiante). *@
        <div class="exam-timer" id="reloj" data-restante="@((int)Math.Max(0, (vence - DateTime.Now).TotalSeconds))">⏱ --:--</div>
    }

    <form asp-action="Enviar" asp-route-id="@Model.Examen.Id" method="post" id="form-examen"
          data-confirm="¿Enviar el examen? No vas a poder cambiar tus respuestas.">
        @for (var i = 0; i < Model.Preguntas.Count; i++)
        {
            var p = Model.Preguntas[i].Pregunta;
            <div class="pregunta">
                <h3>@(i + 1). @p.Enunciado <span class="puntos">(@Ui.Num(p.Puntos) @(p.Puntos == 1 ? "punto" : "puntos"))</span></h3>
                @if (p.Tipo == TipoPregunta.OpcionUnica)
                {
                    @foreach (var o in Model.Preguntas[i].Opciones)
                    {
                        <label class="opcion">
                            <input type="radio" name="p@(p.Id)" value="@o.Id">
                            <span>@o.Texto</span>
                        </label>
                    }
                }
                else
                {
                    <input type="text" name="p@(p.Id)" maxlength="500" autocomplete="off" placeholder="Tu respuesta">
                }
            </div>
        }
        <div class="exam-toolbar">
            <button type="submit" class="admin-btn">Enviar examen</button>
        </div>
    </form>
</section>

@section Scripts {
<script>
    // Cuenta regresiva: al llegar a 0 envía el examen automáticamente (sin pedir confirmación).
    const reloj = document.getElementById("reloj");
    if (reloj) {
        let restante = parseInt(reloj.dataset.restante, 10);
        const form = document.getElementById("form-examen");
        const pintar = () => {
            const m = Math.floor(restante / 60), s = restante % 60;
            reloj.textContent = `⏱ Tiempo restante: ${m}:${String(s).padStart(2, "0")}`;
            reloj.classList.toggle("urgente", restante <= 60);
        };
        pintar();
        const timer = setInterval(() => {
            restante--;
            if (restante <= 0) {
                clearInterval(timer);
                reloj.textContent = "⏱ Tiempo agotado: enviando…";
                form.removeAttribute("data-confirm");
                HTMLFormElement.prototype.submit.call(form);
                return;
            }
            pintar();
        }, 1000);
    }
</script>
}
