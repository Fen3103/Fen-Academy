@model ExamenEditarVM
@{
    var ex = Model.Examen;
    ViewData["Title"] = "Examen: " + ex.Titulo;
    ViewData["Seccion"] = "Editor de examen";
    var bloqueado = Model.Intentos > 0;
}
@section TopbarExtra {
    <a asp-controller="Cursos" asp-action="Ver" asp-route-id="@ex.CursoId" asp-route-tab="evaluacion" class="topbar-link">← Volver al curso</a>
}

<section class="course-banner">
    <div class="course-banner-overlay">
        <h1>@ex.Titulo</h1>
        <p>@ex.Curso.Codigo · @ex.Curso.Nombre · @Ui.Pct(ex.Valor) de la nota ·
           @Model.Preguntas.Count preguntas · @Ui.Num(Model.Preguntas.Sum(p => p.Puntos)) puntos ·
           @(ex.Publicada ? "Publicado" : "Borrador (oculto)")</p>
    </div>
</section>

<div class="exam-toolbar" style="padding-top:18px">
    <form asp-action="Publicar" asp-route-id="@ex.Id" method="post">
        <input type="hidden" name="publicar" value="@(ex.Publicada ? "false" : "true")">
        <button class="admin-btn @(ex.Publicada ? "danger" : "")" type="submit">@(ex.Publicada ? "Ocultar a estudiantes" : "Publicar examen")</button>
    </form>
    @if (bloqueado)
    {
        <span class="estado-chip estado-wait">@Model.Intentos estudiante(s) ya empezaron: las preguntas quedan bloqueadas</span>
    }
</div>

<section class="teacher-grid">
    <div class="course-panel">
        <div class="panel-title">Agregar pregunta</div>
        @if (bloqueado)
        {
            <p class="muted panel-help">No se pueden agregar ni quitar preguntas porque ya hay intentos. Si necesitás corregir algo, podés ajustar la corrección de cada respuesta en la pestaña de resultados.</p>
        }
        else
        {
            <form asp-action="AgregarPregunta" asp-route-id="@ex.Id" method="post" class="form-fen" id="form-pregunta">
                <label>Tipo</label>
                <select name="tipo" id="tipo-pregunta">
                    <option value="OpcionUnica">Opción única (una correcta)</option>
                    <option value="RespuestaCorta">Respuesta corta</option>
                </select>
                <label>Enunciado</label>
                <textarea name="enunciado" required placeholder="¿Qué imprime print(2 ** 3)?"></textarea>
                <label>Puntos</label>
                <input type="number" name="puntos" min="0.5" step="0.5" value="1">

                <div data-tipo="OpcionUnica">
                    <label>Opciones (una por línea; la correcta empieza con *)</label>
                    <textarea name="opciones" rows="5" placeholder="*8&#10;6&#10;9&#10;23"></textarea>
                    <small>Al estudiante se le muestran en orden aleatorio.</small>
                </div>
                <div data-tipo="RespuestaCorta" hidden>
                    <label>Respuestas aceptadas (separadas por |)</label>
                    <input type="text" name="respuestasAceptadas" placeholder="8|ocho">
                    <small>No distingue mayúsculas, tildes ni espacios extra. Los números se comparan por valor (8 = 8.0).</small>
                </div>
                <button class="admin-btn" type="submit">Agregar pregunta</button>
            </form>
        }
    </div>

    <div class="course-panel">
        <div class="panel-title">Configuración</div>
        <form asp-action="Configurar" asp-route-id="@ex.Id" method="post" class="form-fen">
            <label>Título</label>
            <input type="text" name="titulo" value="@ex.Titulo" required>
            <label>Instrucciones</label>
            <textarea name="descripcion">@ex.Descripcion</textarea>
            <label>Fecha límite para comenzar</label>
            <input type="date" name="fechaLimite" value="@ex.FechaLimite?.ToString("yyyy-MM-dd")">
            <label>Duración en minutos (vacío = sin límite)</label>
            <input type="number" name="duracionMinutos" min="1" value="@ex.DuracionMinutos">
            <label class="check">
                <input type="checkbox" name="mostrarSolucion" value="true" checked="@ex.MostrarSolucion">
                Mostrar la corrección al estudiante después de enviar
            </label>
            <button class="admin-btn" type="submit">Guardar configuración</button>
        </form>
    </div>
</section>

<section class="course-panel" style="margin-top:20px">
    <div class="panel-title">Preguntas</div>
    @foreach (var p in Model.Preguntas)
    {
        <div class="pregunta">
            <h3>@p.Orden. @p.Enunciado <span class="puntos">(@Ui.Num(p.Puntos) pts · @(p.Tipo == TipoPregunta.OpcionUnica ? "opción única" : "respuesta corta"))</span></h3>
            @if (p.Tipo == TipoPregunta.OpcionUnica)
            {
                @foreach (var o in p.Opciones)
                {
                    <div class="opcion @(o.EsCorrecta ? "correcta" : "")">@(o.EsCorrecta ? "✓ " : "")@o.Texto</div>
                }
            }
            else
            {
                <p>Respuestas aceptadas: <strong>@string.Join(" / ", ExamenService.Aceptadas(p))</strong></p>
            }
            @if (!bloqueado)
            {
                <div class="respuesta-acciones">
                    <form asp-action="EliminarPregunta" asp-route-id="@p.Id" method="post" data-confirm="¿Eliminar esta pregunta?">
                        <button class="admin-btn danger" type="submit">Eliminar</button>
                    </form>
                </div>
            }
        </div>
    }
    @if (Model.Preguntas.Count == 0)
    {
        <p class="muted panel-help">Todavía no hay preguntas. Agregá al menos una para poder publicar.</p>
    }
</section>

<section class="course-panel" style="margin-top:20px">
    <div class="panel-title">Resultados</div>
    <div class="evaluation-wrapper">
        <table class="evaluation-table">
            <thead><tr><th>Estudiante</th><th>Enviado</th><th>Nota</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in Model.Resultados)
                {
                    <tr>
                        <td>@e.Usuario.Nombre</td>
                        <td>@Ui.Fecha(e.FechaEntrega) @if (e.FueraDeTiempo) { <span class="texto-alerta">(fuera de tiempo)</span> }</td>
                        <td><span class="grade-chip">@Ui.Num(e.Nota)/100</span></td>
                        <td><a class="activity-link" asp-action="Revisar" asp-route-id="@e.Id">Ver respuestas</a></td>
                    </tr>
                }
                @if (Model.Resultados.Count == 0)
                {
                    <tr><td colspan="4">Nadie envió este examen todavía.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
<script>
    // Muestra el campo correcto según el tipo de pregunta.
    const tipo = document.getElementById("tipo-pregunta");
    if (tipo) {
        const actualizar = () => document.querySelectorAll("#form-pregunta [data-tipo]")
            .forEach(d => d.hidden = d.dataset.tipo !== tipo.value);
        tipo.addEventListener("change", actualizar);
        actualizar();
    }
</script>
}
