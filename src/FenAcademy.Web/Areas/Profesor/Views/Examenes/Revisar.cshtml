@model RevisarIntentoVM
@{
    var e = Model.Entrega;
    ViewData["Title"] = "Respuestas de " + e.Usuario.Nombre;
    ViewData["Seccion"] = "Revisión de examen";
}
@section TopbarExtra {
    <a asp-action="Editar" asp-route-id="@e.ActividadId" class="topbar-link">← Volver al examen</a>
}

<section class="course-panel">
    <div class="panel-title">@e.Actividad.Titulo · @e.Usuario.Nombre</div>
    <div class="exam-toolbar">
        <span class="nota-grande">@Ui.Num(e.Nota)/100</span>
        <span>Enviado @Ui.Fecha(e.FechaEntrega)</span>
        @if (e.FueraDeTiempo) { <span class="estado-chip estado-bad">Fuera de tiempo</span> }
        @if (e.Comentario is not null) { <span class="muted">@e.Comentario</span> }
    </div>
    <p class="muted panel-help">La corrección es automática. Si una respuesta corta está bien pero escrita de otra forma, marcala como correcta: la nota se recalcula.</p>

    @foreach (var p in Model.Preguntas)
    {
        Model.Respuestas.TryGetValue(p.Id, out var r);
        <div class="pregunta">
            <h3>@p.Orden. @p.Enunciado <span class="puntos">(@Ui.Num(p.Puntos) pts)</span>
                @if (r?.Correcta == true) { <span class="marca-ok">✓ correcta</span> } else { <span class="marca-mal">✗ incorrecta</span> }
                @if (r?.CorregidaManual == true) { <span class="estado-chip estado-wait">corregida a mano</span> }
            </h3>

            @if (p.Tipo == TipoPregunta.OpcionUnica)
            {
                @foreach (var o in p.Opciones)
                {
                    var clase = o.EsCorrecta ? "correcta" : r?.OpcionId == o.Id ? "elegida-mal" : "";
                    <div class="opcion @clase">@(r?.OpcionId == o.Id ? "● " : "○ ")@o.Texto</div>
                }
            }
            else
            {
                <p>Respuesta: <strong>@(string.IsNullOrEmpty(r?.Texto) ? "(vacía)" : r.Texto)</strong></p>
                <p class="muted">Aceptadas: @string.Join(" / ", ExamenService.Aceptadas(p))</p>
            }

            @if (r is not null)
            {
                <div class="respuesta-acciones">
                    <form asp-action="CambiarCorreccion" asp-route-id="@r.Id" method="post">
                        <input type="hidden" name="correcta" value="@(r.Correcta ? "false" : "true")">
                        <button class="admin-btn @(r.Correcta ? "danger" : "")" type="submit">
                            @(r.Correcta ? "Marcar como incorrecta" : "Marcar como correcta")
                        </button>
                    </form>
                </div>
            }
        </div>
    }

    <form asp-action="Comentar" asp-route-id="@e.Id" method="post" class="form-fen">
        <label>Comentario para el estudiante</label>
        <textarea name="retroalimentacion">@e.Retroalimentacion</textarea>
        <button class="admin-btn" type="submit">Guardar comentario</button>
    </form>
</section>
