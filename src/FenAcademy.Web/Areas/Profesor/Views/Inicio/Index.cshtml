@model List<CursoResumenVM>
@{
    ViewData["Title"] = "Panel docente";
    var esAdmin = User.Rol() == Rol.Admin;
    var porRevisar = Model.Sum(c => c.PorRevisar);
}
<section class="stats-grid stats-grid-3">
    <div class="stat-card"><span>@(esAdmin ? "Cursos (todos)" : "Mis cursos")</span><strong>@Model.Count</strong></div>
    <div class="stat-card"><span>Estudiantes</span><strong>@Model.Sum(c => c.Estudiantes)</strong></div>
    <div class="stat-card @(porRevisar > 0 ? "stat-alerta" : "")"><span>Entregas por revisar</span><strong>@porRevisar</strong></div>
</section>

<section class="course-panel">
    <div class="panel-title">@(esAdmin ? "Todos los cursos" : "Mis cursos")</div>
    <div class="course-list">
        @foreach (var c in Model)
        {
            <a asp-controller="Cursos" asp-action="Ver" asp-route-id="@c.Curso.Id" class="course-link-card">
                <div class="course-item">
                    <h3>@c.Curso.Codigo · @c.Curso.Nombre</h3>
                    <p>@c.Curso.Lenguaje · Nivel @c.Curso.Nivel @(esAdmin ? " · Profesor: " + (c.Curso.Profesor?.Nombre ?? "sin asignar") : "")</p>
                    <p>@c.Curso.Descripcion</p>
                    <div class="meta-row">
                        <span>@c.Estudiantes estudiantes</span>
                        <span>@c.Actividades actividades</span>
                        @if (c.PorRevisar > 0) { <span class="meta-alerta">@c.PorRevisar por revisar</span> }
                    </div>
                </div>
            </a>
        }
        @if (Model.Count == 0)
        {
            <div class="course-item">
                <h3>Sin cursos asignados</h3>
                <p>Cuando un administrador te asigne cursos, aparecerán en este panel.</p>
            </div>
        }
    </div>
</section>
